{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compilar Reboot C",
      "type": "shell",
      "command": "gcc",
      "args": [
        "-Wall",
        "-Wextra",
        "-g",
        "${workspaceFolder}/src/*.c",
        "-I",
        "${workspaceFolder}/include",
        "-o",
        "${workspaceFolder}/reboot_c"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}
